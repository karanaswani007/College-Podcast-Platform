# Vercel production variables — configure these in the Vercel project settings.
# Do not commit real credentials. DATABASE_URL must point to persistent Postgres
# (for example, a Neon pooled connection string with SSL enabled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The public HTTPS origin of this app, with no trailing slash.
BETTER_AUTH_URL=https://your-project.vercel.app

# Generate a unique, high-entropy secret for this deployment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use credentials for this app registered with the Grok auth broker.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=replace-with-your-app-client-id
GROK_AUTH_CLIENT_SECRET=replace-with-your-app-client-secret

# Authentication is enabled for production; this must be available at build time.
VITE_AUTH_ENABLED=true
